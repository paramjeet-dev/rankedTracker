# --- additions for the redesign (merge into your existing .env) ---
# Credentials. The old COC_EMAIL / COC_PASSWORD / COC_KEY_COUNT names are also accepted.
CLASH_EMAIL=
CLASH_PASSWORD=
# IMPORTANT: leave this at the library default. The old crawler never passed a key name, so its 10 keys carry this
# name; a different name would try to create 10 more (portal limit is 10) and fail. COC_KEY_NAME was never used.
CLASH_KEY_NAME=clashofclans.js.keys
CLASH_KEY_COUNT=10
# shared (default): only `availability` logs in and the other processes follow its keys. login: every process logs in
# by itself (only safe if just one process uses the account).
CLASH_KEYS_MODE=shared
CLASH_REQUEST_TIMEOUT_MS=15000

VALKEY_URL=redis://127.0.0.1:6379

# Each process gets its own small Postgres pool (the old DB_POOL=40 would exceed max_connections with 5 processes)
PG_POOL_MAX=8

DISCOVERY_REFRESH_DAYS=7

# Per-pool request budgets (request starts per second, simultaneous requests).
# Keep the sum of all pools below COC_RATE_PER_KEY x key count (20 x 10 = 200) and raise gradually.
POOL_PLAYERS_DISCOVERY_NEW_RPS=10
POOL_PLAYERS_DISCOVERY_NEW_MAX_IN_FLIGHT=20
POOL_PLAYERS_DISCOVERY_REFRESH_RPS=2
POOL_PLAYERS_DISCOVERY_REFRESH_MAX_IN_FLIGHT=4
POOL_GROUPS_RPS=8
POOL_GROUPS_MAX_IN_FLIGHT=16
POOL_PLAYERS_PROFILE_NEW_RPS=12
POOL_PLAYERS_PROFILE_NEW_MAX_IN_FLIGHT=24
POOL_PLAYERS_PROFILE_REFRESH_RPS=4
POOL_PLAYERS_PROFILE_REFRESH_MAX_IN_FLIGHT=8
# Keep finished seasons only for tiers 26-33 (set false to keep every league)
HISTORY_SCOPE_ONLY=true
POOL_BATTLES_RPS=20
POOL_BATTLES_MAX_IN_FLIGHT=40
# Groups collected at the same time (each group's members are fetched one after another)
BATTLES_WORKERS=24

# --- fixed outgoing IP (see docs/proxy.md) ---
# Send all Clash traffic (portal login and API) through a proxy on a server with a fixed IP, so a changing home IP does
# not invalidate the keys. Leave empty for a direct connection.
# OUTBOUND_PROXY_URL=socks5://127.0.0.1:1080
