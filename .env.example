# --- gateway (runs on the VPS) ---
GATEWAY_SECRET=change-me-long-random
COC_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
RPS_PER_KEY=15
MAX_QUEUE=3000
PORT=8787
# --- workers (run locally) ---
GATEWAY_URL=http://127.0.0.1:8787   # use 127.0.0.1, not "localhost": on Windows localhost tries IPv6 first and adds delay
DATABASE_URL=postgres://coc:coc@localhost:5432/coc
RAW_DIR=./data/raw
# --- per-process request rates (sum should stay under gateway capacity: keys x RPS_PER_KEY) ---
RPS_SEEDS=5
RPS_PROFILE=10
RPS_HISTORY=15
RPS_ROSTER=20
RPS_MEMBERLOG=100
CONC_MEMBERLOG=200
MEMBERLOG_DEPTH=1        # coverage dial: 0..1 share of each group's members whose logs are fetched (top 5 + promotion/demotion bubble always fetched)
RAW_RETENTION_DAYS=30
HOST=127.0.0.1   # gateway bind address (on the VPS)
GROUP_STYLE=playerTag   # how the group endpoint receives the player tag: playerTag|tag|player|path|none (npm run smoke tells you)
# CONC_* = jobs claimed at once; they are fetched in batches of up to 100 per gateway round trip (needs the new gateway). RPS_* = pacing; all processes together should stay under keys x RPS_PER_KEY
CONC_PROFILE=100
CONC_HISTORY=100
CONC_ROSTER=100
