POSTGRES_PASSWORD=coc_dev
DATABASE_URL=postgres://coc:coc_dev@localhost:5432/coc
# Developer portal login. The library creates/rotates API keys for the current IP automatically.
COC_EMAIL=
COC_PASSWORD=
# Optional: name and number of keys the library manages
COC_KEY_NAME=coc-tracker
COC_KEY_COUNT=1
# Player tag parameter name for /leaguegroup/{tag}/{season} (confirmed: playerTag)
LEAGUE_GROUP_PLAYER_PARAM=playerTag
