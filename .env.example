POSTGRES_PASSWORD=coc_dev
DATABASE_URL=postgres://coc:coc_dev@localhost:5432/coc
# Developer portal login. The library creates/rotates API keys for the current IP automatically.
COC_EMAIL=
COC_PASSWORD=
# Optional: name and number of keys the library manages
COC_KEY_NAME=coc-tracker
COC_KEY_COUNT=10
# Requests per second per key (total = this x key count). Lower it if you see many 429 errors.
COC_RATE_PER_KEY=20
# Parallel workers and Postgres pool size (pool must be >= workers)
CRAWL_CONCURRENCY=32
DB_POOL=40
# Player tag parameter name for /leaguegroup/{tag}/{season} (confirmed: playerTag)
LEAGUE_GROUP_PLAYER_PARAM=playerTag

# --- crawler behaviour (defaults are the efficient choice) ---
# true = also collect battle logs while a season is still running (default false: rosters only, logs after the season ends)
LIVE_LOGS=false
# all = fetch every member of every group (default: stop as soon as all battles of the group are stored)
COLLECT=cover
# true = also profile every group-mate (default false: their clans are crawled instead)
DISCOVER_GROUPMATES=false
