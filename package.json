{
  "name": "coc-tracker-v2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test packages/shared/src/*.test.ts && node --import tsx test/integration.ts",
    "gateway": "node --env-file=.env --import tsx apps/gateway/src/index.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test:integration": "node --import tsx test/integration.ts",
    "validate": "node --env-file=.env --import tsx scripts/validate.ts",
    "aggregator": "node --import tsx apps/aggregator/src/index.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "add-seed": "node --env-file=.env --import tsx scripts/add-seed.ts",
    "status": "node --env-file=.env --import tsx scripts/status.ts",
    "start:availability": "node --env-file=.env --import tsx apps/availability/src/index.ts",
    "start:scheduler": "node --env-file=.env --import tsx apps/scheduler/src/index.ts",
    "start:seeds": "node --env-file=.env --import tsx apps/seeds/src/index.ts",
    "start:profile": "node --env-file=.env --import tsx apps/profile/src/index.ts",
    "start:history": "node --env-file=.env --import tsx apps/history/src/index.ts",
    "start:roster": "node --env-file=.env --import tsx apps/roster/src/index.ts",
    "start:memberlog": "node --env-file=.env --import tsx apps/memberlog/src/index.ts",
    "start:aggregator": "node --env-file=.env --import tsx apps/aggregator/src/index.ts",
    "cleanup": "node --env-file=.env --import tsx scripts/cleanup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@electric-sql/pglite": "^0.3.0",
    "@electric-sql/pglite-socket": "^0.0.20"
  }
}