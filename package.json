{
  "name": "coc-tracker-v2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test packages/shared/src/*.test.ts && node --import tsx test/integration.ts",
    "gateway": "node --env-file=.env --import tsx apps/gateway/src/index.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test:integration": "node --import tsx test/integration.ts",
    "validate": "node --env-file=.env --import tsx scripts/validate.ts",
    "aggregator": "node --import tsx apps/aggregator/src/index.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@electric-sql/pglite": "^0.3.0",
    "@electric-sql/pglite-socket": "^0.0.20"
  }
}